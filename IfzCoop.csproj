<Project Sdk="Microsoft.NET.Sdk">

  <!--
    IFZ Koop: BepInEx-5-Plugin fÃ¼r Infection Free Zone (Unity 6000.0.26f1, Mono).

    Bauen:  dotnet build -c Release
    Pfade Ã¼berschreiben, falls nÃ¶tig:
      dotnet build -c Release -p:TestGameDir="D:\IFZ-Test"

    GameManagedDir: nur gelesen (Verweise auf die Spiel-DLLs), nichts wird dort verÃ¤ndert.
    TestGameDir:    die Testkopie des Spiels mit installiertem BepInEx. Nach dem Bauen wird
                    IfzCoop.dll nach TestGameDir\BepInEx\plugins\IfzCoop\ kopiert.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>IfzCoop</AssemblyName>
    <RootNamespace>IfzCoop</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.23.14</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0618;MSB3277</NoWarn>

    <GameManagedDir Condition="'$(GameManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Infection Free Zone\Infection Free Zone_Data\Managed</GameManagedDir>
    <TestGameDir Condition="'$(TestGameDir)' == ''">C:\IFZ-Test</TestGameDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(TestGameDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="updater\**;launcher\**" />
    <None Remove="updater\**;launcher\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Ifz">
      <HintPath>$(GameManagedDir)\Ifz.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CallSystem">
      <HintPath>$(GameManagedDir)\CallSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TileMapSystemCamera">
      <HintPath>$(GameManagedDir)\TileMapSystemCamera.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(GameManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MapOperator">
      <HintPath>$(GameManagedDir)\MapOperator.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="JutsuGamesConfig">
      <HintPath>$(GameManagedDir)\JutsuGamesConfig.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RTree">
      <HintPath>$(GameManagedDir)\RTree.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Laungage">
      <HintPath>$(GameManagedDir)\Laungage.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zenject">
      <HintPath>$(GameManagedDir)\Zenject.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(GameManagedDir)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Paket zum Weitergeben: dist\IfzCoop-<Version>\ mit Installer, DLL und Kurzanleitung. Den Ordner zippen und verschicken. -->
  <Target Name="Package" AfterTargets="Build">
    <PropertyGroup>
      <PackageDir>$(MSBuildProjectDirectory)\dist\IfzCoop-$(Version)</PackageDir>
    </PropertyGroup>
    <MakeDir Directories="$(PackageDir)" />
    <!-- Updater (Preloader-Patcher, eigenes Projekt) mitbauen -->
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\updater\IfzCoop.Updater.csproj&quot; -c $(Configuration) -nologo -v:q &quot;-p:BepInExCoreDir=$(BepInExCoreDir)&quot;" />
    <!-- Launcher (Windows-Programm, .NET Framework 4.8) -->
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\launcher\IfzCoop.Launcher.csproj&quot; -c $(Configuration) -nologo -v:q" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\updater\bin\$(Configuration)\IfzCoop.Updater.dll;$(MSBuildProjectDirectory)\launcher\bin\$(Configuration)\IfzCoop-Launcher.exe;$(MSBuildProjectDirectory)\installer\IfzCoop-Installer.bat;$(MSBuildProjectDirectory)\installer\LIESMICH.txt" DestinationFolder="$(PackageDir)" />
    <Message Importance="high" Text="Paket: $(PackageDir)" />
  </Target>

  <Target Name="CopyToTestGame" AfterTargets="Build" Condition="Exists('$(TestGameDir)\BepInEx\plugins')">
    <MakeDir Directories="$(TestGameDir)\BepInEx\plugins\IfzCoop" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TestGameDir)\BepInEx\plugins\IfzCoop" />
    <Message Importance="high" Text="IfzCoop.dll -> $(TestGameDir)\BepInEx\plugins\IfzCoop" />
  </Target>

</Project>
